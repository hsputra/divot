{
  "name": "divot",
  "version": "0.1.0",
  "description": "Fast diff/patch engine, in Rust, with Python and Node bindings.",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "napi build --platform --release --features node",
    "build:debug": "napi build --platform --features node",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsputra/divot.git"
  },
  "keywords": ["diff", "patch", "myers", "histogram", "rust"],
  "author": "Henry Syahputra <henry.syahputra@gmail.com>",
  "license": "MIT OR Apache-2.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/hsputra/divot/issues"
  },
  "homepage": "https://github.com/hsputra/divot#readme",
  "napi": {
    "binaryName": "divot",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.2"
  }
}
